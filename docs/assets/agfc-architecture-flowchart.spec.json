{
  "width": 1480,
  "height": 900,
  "background": "page",
  "title": "AGFC 平台化架构：稳定抽图能力与跨项目修复",
  "layout_groups": [
    {
      "id": "core-capability-cards",
      "items": ["atom-graph", "negative-evidence", "closure-ranking", "figure-export"],
      "equal": ["width", "height"]
    },
    {
      "id": "application-cards",
      "items": ["mineru-repair", "dataproxy-adapter", "other-systems", "agent-mcp"],
      "equal": ["height"]
    }
  ],
  "elements": [
    { "type": "plate", "id": "base", "x": 28, "y": 72, "w": 1424, "h": 768, "fill": "plate" },

    { "type": "rail", "id": "consumer-rail", "x": 52, "y": 132, "w": 124, "h": 584, "label": "跨项目消费者", "icon": "app", "font_size": 17 },

    { "type": "plate", "id": "input-panel", "x": 220, "y": 118, "w": 250, "h": 430, "fill": "white", "allow_mixed_size": true },
    { "type": "bar", "id": "input-bar", "x": 220, "y": 118, "w": 250, "h": 36, "label": "输入与触发", "variant": "blue", "title_role": "section_bar", "icon": "document" },
    { "type": "node", "id": "source-doc", "x": 244, "y": 170, "w": 202, "h": 84, "label": "源文档", "items": ["PDF / PPTX / DOCX", "页面图像与版面对象"], "variant": "white", "align": "left" },
    { "type": "node", "id": "mineru-artifact", "x": 244, "y": 292, "w": 202, "h": 92, "label": "MinerU 解析工件", "items": ["content_list.json", "full.md / extracted / images"], "variant": "white", "align": "left", "font_size": 14 },
    { "type": "node", "id": "candidate-evidence", "x": 244, "y": 420, "w": 202, "h": 78, "label": "候选证据", "items": ["文本 / 栅格 / 矢量", "版面原语"], "variant": "green", "align": "left" },

    { "type": "plate", "id": "core-panel", "x": 620, "y": 118, "w": 420, "h": 430, "fill": "white", "allow_mixed_size": true },
    { "type": "bar", "id": "core-bar", "x": 620, "y": 118, "w": 420, "h": 36, "label": "AGFC 核心与运行入口", "variant": "blue", "title_role": "section_bar", "icon": "brain" },
    { "type": "bar", "id": "runtime-entry", "x": 646, "y": 174, "w": 368, "h": 42, "label": "CLI / HTTP Sidecar / Python / MCP", "variant": "green", "title_role": "bus_bar", "icon": "api", "font_size": 14 },
    { "type": "node", "id": "atom-graph", "x": 646, "y": 248, "w": 162, "h": 78, "label": "原子图构建", "items": ["文本 / 位图 / 矢量", "版面原语归一化"], "variant": "white", "align": "left", "font_size": 14 },
    { "type": "node", "id": "negative-evidence", "x": 852, "y": 248, "w": 162, "h": 78, "label": "负证据过滤", "items": ["正文 / 页脚 / 表格", "误抽区域抑制"], "variant": "risk-soft", "align": "left", "font_size": 14 },
    { "type": "node", "id": "closure-ranking", "x": 646, "y": 372, "w": 162, "h": 78, "label": "闭包排序", "items": ["候选边界评分", "panel 逻辑分组"], "variant": "green", "align": "left", "font_size": 14 },
    { "type": "node", "id": "figure-export", "x": 852, "y": 372, "w": 162, "h": 78, "label": "图像导出", "items": ["figure crop", "PNG 文件", "review_html"], "variant": "green", "align": "left", "font_size": 14, "items_font_size": 10.5 },

    { "type": "plate", "id": "contract-panel", "x": 1180, "y": 118, "w": 250, "h": 430, "fill": "white", "allow_mixed_size": true },
    { "type": "bar", "id": "contract-bar", "x": 1180, "y": 118, "w": 250, "h": 36, "label": "稳定 Contract", "variant": "green", "title_role": "section_bar", "icon": "shield" },
    { "type": "node", "id": "extract-json", "x": 1196, "y": 178, "w": 218, "h": 142, "label": "统一 JSON 结果", "items": ["page_idx / figure_id", "figure_bbox", "content_bbox", "support_bbox / caption_text", "panel_ids / logical_group_id"], "variant": "green", "align": "left", "font_size": 14, "items_font_size": 10.5 },
    { "type": "node", "id": "artifact-paths", "x": 1196, "y": 350, "w": 218, "h": 88, "label": "文件产物路径", "items": ["images_dir / review_html", "summary_json / run_dir"], "variant": "white", "align": "left", "font_size": 14 },
    { "type": "node", "id": "schema-version", "x": 1196, "y": 466, "w": 218, "h": 54, "label": "JSON Schema 版本化", "subtitle": "不暴露 DataProxy 私货", "variant": "green", "icon": "shield", "font_size": 13 },

    { "type": "plate", "id": "application-panel", "x": 220, "y": 612, "w": 1210, "h": 128, "fill": "white" },
    { "type": "bar", "id": "application-bar", "x": 220, "y": 612, "w": 1210, "h": 36, "label": "插件化应用与跨项目复用", "variant": "blue", "title_role": "section_bar", "icon": "wrench", "connector_passthrough": true },
    { "type": "node", "id": "mineru-repair", "x": 244, "y": 668, "w": 270, "h": 56, "label": "MinerU 修复插件", "subtitle": "替换图片并回写副本工件", "variant": "green", "icon": "wrench", "font_size": 14 },
    { "type": "node", "id": "dataproxy-adapter", "x": 548, "y": 668, "w": 270, "h": 56, "label": "DataProxy 薄适配", "subtitle": "只做 contract 映射", "variant": "white", "icon": "api", "font_size": 14 },
    { "type": "node", "id": "other-systems", "x": 852, "y": 668, "w": 270, "h": 56, "label": "其他解析 / 检索系统", "subtitle": "语言无关接入", "variant": "white", "icon": "app", "font_size": 14 },
    { "type": "node", "id": "agent-mcp", "x": 1156, "y": 668, "w": 250, "h": 56, "label": "Agent / MCP 工具", "subtitle": "外层薄适配", "variant": "white", "icon": "api", "font_size": 14 },

    { "type": "bar", "id": "governance-bar", "x": 220, "y": 778, "w": 1210, "h": 42, "label": "发布治理：JournalMix-v1 Benchmark / CI 回归 / Release Checklist", "variant": "green", "title_role": "bus_bar", "icon": "shield", "font_size": 15 },
    { "type": "bar", "id": "principle-bar", "x": 220, "y": 828, "w": 1210, "h": 34, "label": "设计原则：AGFC 维护核心算法与稳定 contract，下游项目只依赖 CLI / HTTP / JSON Schema", "variant": "black", "title_role": "bus_bar", "font_size": 14 },

    { "type": "connector", "id": "consumer-to-doc", "from_ref": { "id": "consumer-rail", "side": "right", "offset": 0.15 }, "to_ref": { "id": "source-doc", "side": "left", "offset": 0.5 } },
    { "type": "connector", "id": "consumer-to-mineru", "from_ref": { "id": "consumer-rail", "side": "right", "offset": 0.36 }, "to_ref": { "id": "mineru-artifact", "side": "left", "offset": 0.5 } },
    { "type": "connector", "id": "doc-to-runtime", "from_ref": { "id": "source-doc", "side": "right", "offset": 0.5 }, "to_ref": { "id": "runtime-entry", "side": "left", "offset": 0.42 }, "route": "hv", "mid_x": 546, "label": "抽图请求", "label_lane": "parallel", "label_side": "above" },
    { "type": "connector", "id": "mineru-to-runtime", "from_ref": { "id": "mineru-artifact", "side": "right", "offset": 0.5 }, "to_ref": { "id": "runtime-entry", "side": "left", "offset": 0.74 }, "points": [[446, 338], [536, 338], [536, 205], [646, 205]], "label": "修复请求", "label_lane": "parallel", "label_side": "right" },
    { "type": "connector", "id": "evidence-to-atom", "from_ref": { "id": "candidate-evidence", "side": "right", "offset": 0.5 }, "to_ref": { "id": "atom-graph", "side": "left", "offset": 0.5 }, "route": "hv", "mid_x": 536, "label": "证据归一", "label_lane": "parallel", "label_side": "below" },

    { "type": "connector", "id": "runtime-to-atom", "from_ref": { "id": "runtime-entry", "side": "bottom", "offset": 0.23 }, "to_ref": { "id": "atom-graph", "side": "top", "offset": 0.5 } },
    { "type": "connector", "id": "atom-to-negative", "from_ref": { "id": "atom-graph", "side": "right", "offset": 0.5 }, "to_ref": { "id": "negative-evidence", "side": "left", "offset": 0.5 } },
    { "type": "connector", "id": "atom-to-closure", "from_ref": { "id": "atom-graph", "side": "bottom", "offset": 0.5 }, "to_ref": { "id": "closure-ranking", "side": "top", "offset": 0.5 } },
    { "type": "connector", "id": "negative-to-export", "from_ref": { "id": "negative-evidence", "side": "bottom", "offset": 0.5 }, "to_ref": { "id": "figure-export", "side": "top", "offset": 0.5 } },
    { "type": "connector", "id": "closure-to-export", "from_ref": { "id": "closure-ranking", "side": "right", "offset": 0.5 }, "to_ref": { "id": "figure-export", "side": "left", "offset": 0.5 } },

    { "type": "connector", "id": "export-to-contract", "from_ref": { "id": "figure-export", "side": "right", "offset": 0.5 }, "to_ref": { "id": "extract-json", "side": "left", "offset": 0.5 }, "route": "hv", "mid_x": 1109, "label": "稳定输出", "label_lane": "parallel", "label_side": "right" },
    { "type": "connector", "id": "json-to-artifacts", "from_ref": { "id": "extract-json", "side": "bottom", "offset": 0.5 }, "to_ref": { "id": "artifact-paths", "side": "top", "offset": 0.5 } },
    { "type": "connector", "id": "artifacts-to-schema", "from_ref": { "id": "artifact-paths", "side": "bottom", "offset": 0.5 }, "to_ref": { "id": "schema-version", "side": "top", "offset": 0.5 } },

    { "type": "connector", "id": "contract-to-application", "from_ref": { "id": "extract-json", "side": "bottom", "offset": 0.5 }, "to_ref": { "id": "mineru-repair", "side": "top", "offset": 0.5 }, "points": [[1305, 320], [1440, 320], [1440, 585], [379, 585], [379, 668]], "label": "读取 contract", "label_lane": "parallel", "label_side": "above" },
    { "type": "connector", "id": "mineru-to-dataproxy", "from_ref": { "id": "mineru-repair", "side": "right", "offset": 0.5 }, "to_ref": { "id": "dataproxy-adapter", "side": "left", "offset": 0.5 } },
    { "type": "connector", "id": "dataproxy-to-other", "from_ref": { "id": "dataproxy-adapter", "side": "right", "offset": 0.5 }, "to_ref": { "id": "other-systems", "side": "left", "offset": 0.5 } },
    { "type": "connector", "id": "other-to-agent", "from_ref": { "id": "other-systems", "side": "right", "offset": 0.5 }, "to_ref": { "id": "agent-mcp", "side": "left", "offset": 0.5 } },
    { "type": "connector", "id": "apps-to-governance", "from_ref": { "id": "other-systems", "side": "bottom", "offset": 0.5 }, "to_ref": { "id": "governance-bar", "side": "top", "offset": 0.62 } }
  ]
}
