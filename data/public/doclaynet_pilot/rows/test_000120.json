          409.75877197149646,
          333.01078399159667,
          12.106442992874122
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/MENEIG+NissanAG-Light",
          "size": 1.0
        },
        "text": "we can push our teams towards higher targets because"
      },
      {
        "bbox": [
