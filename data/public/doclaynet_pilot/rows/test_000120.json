          188.64978399159665,
          12.106455166270734
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/MENEIG+NissanAG-Light",
          "size": 1.0
        },
        "text": "their confidence level is higher. "
      }
    ],
    [
      {
        "bbox": [
          542.0380537815126,
          293.8682060570071,
          306.9626071428571,
          12.106442992874236
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/MENEIG+NissanAG-Light",
          "size": 1.0
        },
        "text": "The global expansion of the Infiniti brand is another"
      },
      {
        "bbox": [
