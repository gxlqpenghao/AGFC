        "text": "F e b ru a ry 9, 2001 "
      }
    ],
    [
      {
        "bbox": [
          246.52589869281044,
          819.8731691919193,
          262.47533415032683,
          10.634362058080796
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/BLGONC+Univers-CondensedOblique",
          "size": 9.0
        },
        "text": "Dating back to the 14th century, the Charles"
      },
      {
        "bbox": [
          246.42540849673202,
          840.5802398989899,
          298.8930147058824,
          10.634362058080768
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/BLGONC+Univers-CondensedOblique",
          "size": 9.0
        },
        "text": "Bridge is one of the jewels of Gothic architecture."
      },
      {
        "bbox": [
          246.3064950980392,
          861.2873106060606,
          284.25661764705893,
          10.634375000000006
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/BLGONC+Univers-CondensedOblique",
          "size": 9.0
        },
        "text": "This stone bridge, built by Charles IV, the Czech"
      },
      {
        "bbox": [
          246.2060216503268,
          881.9943813131313,
          295.1246491013072,
          10.634374999999977
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/BLGONC+Univers-CondensedOblique",
          "size": 9.0
        },
        "text": "King and Holy Roman Emperor, created a reliable"
      },
      {
        "bbox": [
          246.52089093137258,
          902.7014507260101,
          297.6569685457516,
          10.63437888257576
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/BLGONC+Univers-CondensedOblique",
          "size": 9.0
        },
        "text": "connection between the Lesser and the Old Town"
      },
      {
        "bbox": [
          246.43547426470587,
          923.4085214330808,
          298.8930147058823,
          10.634378882575774
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/BLGONC+Univers-CondensedOblique",
          "size": 9.0
        },
        "text": "and gave way to the merging of life of both banks."
