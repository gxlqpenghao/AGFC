            0,
            255
          ],
          "name": "/Optima-Bold",
          "size": 1.0
        },
        "text": "PEOPLE OF SHENTEL"
      }
    ],
    [
      {
        "bbox": [
          120.96657920751635,
          97.61054292929305,
          822.2899722630718,
          27.954584280302925
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "For over 100 years Shenandoah Telecommunications Company has been committed to providing outstanding"
      },
      {
        "bbox": [
          92.11568145424837,
          123.98554008838391,
          186.09311797385618,
          12.812538825757542
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "service to our customers."
      },
      {
        "bbox": [
          292.1685625,
          123.98554008838391,
          606.3196401143791,
          12.812538825757542
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "Our employees take that same dedication after hours to make a difference in their"
      },
      {
        "bbox": [
          92.11568145424837,
          138.86938131313138,
          87.32781936274509,
          12.812538825757656
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "community."
      }
    ],
    [
      {
        "bbox": [
          120.96641339869282,
          164.105735479798,
          766.968995506536,
          12.812525883838475
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "We take this opportunity to share with you, our shareholders, the stories of just a few of your dedicated"
      },
      {
        "bbox": [
          92.11568145424837,
          178.98815309343445,
          83.38341168300653,
          12.812525883838248
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "employees."
      }
    ],
    [
      {
        "bbox": [
          367.9280878267974,
          200.82360385101015,
          574.5041258169936,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "Volunteerism is in Patty Pomeroy’s blood. Her grandfather was a dispatcher for the"
      },
      {
        "bbox": [
          337.781029003268,
          216.35390688131315,
          567.4931928104575,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "rescue squad in Middletown, VA for 25 years and her grandmother was in the ladies"
      },
      {
        "bbox": [
          337.781029003268,
          231.88420991161615,
          523.9980547385621,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "auxiliary. Her father was a charter member of the Middletown Rescue Squad."
      },
      {
        "bbox": [
          874.4483014705881,
          231.88420991161615,
          56.30185988562107,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "In 1997,"
      },
      {
        "bbox": [
          337.781029003268,
          247.41451294191916,
          582.4126707516339,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "Patty, a customer service representative at Shentel for four years, continued the family"
      },
      {
        "bbox": [
          337.781029003268,
          262.9448159722223,
          627.5445428921569,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "tradition by earning her Emergency Medical Technician certification and going to “work”"
      },
      {
        "bbox": [
          337.781029003268,
          278.4751190025253,
          582.8045992647058,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "for the Strasburg Rescue Squad. Patty is the administrator of membership recruitment"
      },
      {
        "bbox": [
          337.781029003268,
          294.0054220328283,
          602.9764485294118,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "and retention for the squad and is the liaison coordinator for junior squad members under"
      },
      {
        "bbox": [
          337.781029003268,
          309.5357250631313,
          21.227180555555606,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "18."
      },
      {
        "bbox": [
          371.74452124183006,
          309.5357250631313,
          564.5410755718955,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "It is her job to make sure that new members are brought in to the squad and current"
      },
      {
        "bbox": [
          337.781029003268,
          325.0660280934343,
          141.74143831699348,
          11.647727272727366
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "members stay active."
      }
    ],
    [
      {
        "bbox": [
          122.26307189542484,
          397.5977717803031,
          559.7873533496731,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "Jeff Beard has been an installer repairman with Shentel for almost five years. Two"
      },
      {
        "bbox": [
          92.11601307189542,
          413.1280748106061,
          601.7202708333334,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "years ago, Jeff helped start Project Isaiah 58, a faith-based recovery ministry that reaches"
      },
      {
        "bbox": [
          92.11601307189542,
          428.6583778409091,
          570.9116180555557,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "out to people who are struggling with addiction. Project Isaiah 58 has weekly group"
      },
      {
        "bbox": [
          92.11601307189542,
          444.1886808712122,
          587.728518382353,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "meetings in Winchester, Woodstock and Warrenton, VA. Jeff, who lives in Winchester,"
      },
      {
        "bbox": [
          92.11601307189542,
          459.71898390151523,
          590.0198120915034,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "participates in the group meetings and also makes time to meet one-on-one with people"
      },
      {
        "bbox": [
          92.11601307189542,
          475.24928693181823,
          193.78194444444446,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "who need personal attention."
      }
    ],
    [
      {
        "bbox": [
          366.92151102941176,
          594.3265912247475,
          547.1708594771242,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "John Gardner has been with Shentel for two years as a PCS technician in Central"
      },
      {
        "bbox": [
          336.77445220588237,
          609.8568942550505,
          604.7533831699348,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "Pennsylvania, but for almost a year of that time he was on Naval Reserve duty in Sasebo,"
      },
      {
        "bbox": [
          336.77445220588237,
          625.3871972853535,
          42.7691633986928,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "Japan."
      },
      {
        "bbox": [
          392.2372691993464,
          625.3871972853535,
          420.6847540849673,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "John joined the Reserves after serving 10 years of active duty."
      },
      {
        "bbox": [
          825.615676879085,
          625.3871972853535,
          115.15682393790848,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "In October 2002,"
      },
      {
        "bbox": [
          336.77445220588237,
          640.9175003156565,
          602.0417892156863,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "he was activated under Noble Eagle-Enduring Freedom as part of the increase in security"
      },
      {
        "bbox": [
          336.77445220588237,
          656.4465091540404,
          593.2019848856207,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "at bases around the world. John worked on Motorola radios and repeater systems while"
      },
      {
        "bbox": [
          336.77445220588237,
          671.975505050505,
          550.316085375817,
          11.647727272727309
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "stationed in Japan. It was tough for the serviceman to be away from his wife and"
      },
      {
        "bbox": [
          336.77445220588237,
          687.505808080808,
          429.153448120915,
          11.64770138888889
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "children, but John believes very strongly in serving his country."
      }
    ],
    [
      {
        "bbox": [
          122.89615678104576,
          793.9582443181819,
          548.0550928104575,
          11.64772727272728
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "At Shentel, George Brinkley, the store manager in Front Royal, VA, is known for"
      },
      {
        "bbox": [
          92.74909795751634,
          809.4885473484849,
          558.4625107026144,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "being one of the biggest fund-raisers for the Shenandoah County American Cancer"
      },
      {
        "bbox": [
          92.74909795751634,
          825.0188503787879,
          593.1048644607843,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "Society Relay for Life event. In his six years at the Company, George has raised nearly"
      },
      {
        "bbox": [
          92.74909795751634,
          840.5491534090909,
          597.3840719771242,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "$20,000. In 2003, he raised $4,246 and was recognized as the top individual fund-raiser"
      },
      {
        "bbox": [
          92.74909795751634,
          856.079456439394,
          132.37739673202614,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "for the entire event."
      }
    ],
    [
      {
        "bbox": [
          122.89615678104576,
          881.9710599747475,
          534.4688350490196,
          11.64772727272728
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "In 2002, George was chairman of the parade committee for the Woodstock, VA"
      },
      {
        "bbox": [
          92.74909795751634,
          897.5013604166667,
          588.142306862745,
          11.647727272727266
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "250th anniversary celebration. Under George’s leadership, the 26-member committee"
      },
      {
        "bbox": [
          92.74909795751634,
          913.0316634469697,
          605.2624698529412,
          11.64772727272728
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Roman",
          "size": 1.0
        },
        "text": "worked for a year preparing for the parade, which was the largest in the town’s history. "
      }
    ],
    [],
    [],
    [],
    [],
    [
      {
        "bbox": [
          145.38787246732028,
          374.78246243686874,
          111.4732754084967,
          12.8125
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-BoldItalic",
          "size": 1.0
        },
        "text": "Patty Pomeroy"
      }
    ],
    [
      {
        "bbox": [
          786.1197303921568,
          573.5205148358586,
          76.78482679738568,
          12.23012657828275
        ],
        "font": {
          "color": [
            0,
            0,
