            255
          ],
          "name": "/Times-BoldItalic",
          "size": 1.0
        },
        "text": "Jeff Beard"
      }
    ],
    [
      {
        "bbox": [
          153.3142125408497,
          770.8045426136364,
          103.50640428921568,
          12.230113636363626
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-BoldItalic",
          "size": 1.0
        },
        "text": "John Gardner"
      }
    ],
    [
      {
        "bbox": [
          768.1135620915032,
          961.9335101010101,
          120.08446119281052,
          12.230114930555558
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-BoldItalic",
          "size": 1.0
        },
        "text": "George Brinkley"
      }
    ],
    [
      {
        "bbox": [
          776.1092487745098,
          980.785743655303,
          7.449673202614463,
          10.581314425505056
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Optima",
          "size": 1.0
        },
        "text": "3"
      },
      {
        "bbox": [
          795.8421401143792,
          979.7426249684344,
          17.388136846405132,
          11.647727272727266
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/EKNAFH+ZapfDingbats",
          "size": 1.0
        },
        "text": "■ "
      },
      {
        "bbox": [
          821.8958982843137,
          980.785743655303,
          142.21769485294112,
          10.581314425505056
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Optima",
          "size": 1.0
        },
        "text": "2003 ANNUAL REPORT"
      }
    ],
    [
      {
        "bbox": [
          336.77445220588237,
          718.5663882575758,
          611.0005906862743,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Bold",
          "size": 1.0
        },
        "text": "“Being in the Reserves is a way for me to be a civilian and still serve my country.”"
      }
    ],
    [
      {
        "bbox": [
          92.74909795751634,
          938.9232734532828,
          618.4619241013072,
          11.647722095959594
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Bold",
          "size": 1.0
        },
        "text": "“I just have a knack for volunteering. I want to make my community better any way"
      },
      {
        "bbox": [
          92.74909795751634,
          954.4535713068182,
          6.855960375816991,
          11.647727272727266
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Bold",
          "size": 1.0
        },
        "text": "I"
      },
      {
        "bbox": [
          104.01120339052288,
          954.4535713068182,
          48.467595629084954,
          11.647727272727266
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Bold",
          "size": 1.0
        },
        "text": "can.”"
      }
    ],
    [
      {
        "bbox": [
          337.781029003268,
          356.1266341540404,
          591.6979816176472,
          11.647766098484908
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Bold",
          "size": 1.0
        },
        "text": "“There is a great satisfaction that comes from knowing that what you can do will"
      },
      {
        "bbox": [
          337.781029003268,
          371.65697601010106,
          105.32544934640521,
          11.647727272727252
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Bold",
          "size": 1.0
        },
        "text": "help people.”"
      }
    ],
    [
      {
        "bbox": [
          92.11601307189542,
          506.30989299242424,
          439.7383986928105,
          11.647727272727309
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Times-Bold",
          "size": 1.0
        },
        "text": "“I feel the need to reach out to people who are suffering.” "
      }
    ]
  ],
