        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/MENEIG+NissanAG-Light",
          "size": 1.0
        },
        "text": "maintain both a balance and a clear separation between the"
      },
      {
        "bbox": [
          542.5114142857143,
          740.8756728028504,
          337.46664159663874,
          12.106442992874122
        ],
        "font": {
          "color": [
            0,
            0,
