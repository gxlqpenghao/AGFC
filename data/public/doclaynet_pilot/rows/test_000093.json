        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/MENEIG+NissanAG-Light",
          "size": 1.0
        },
        "text": "One way to sustain our strong pace is to take greater"
      },
      {
        "bbox": [
