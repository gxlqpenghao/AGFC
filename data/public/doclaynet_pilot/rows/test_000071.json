      {
        "bbox": [
          178.58652521008403,
          369.8471710213777,
          665.7761571428573,
          11.82084293349169
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/Goudy",
          "size": 1.0
        },
        "text": "reviewed all Depreciation Rates at the commencement of this financial year. It was agreed that"
