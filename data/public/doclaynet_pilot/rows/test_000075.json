          317.38685369747895,
          9.62302137767233
        ],
        "font": {
          "color": [
            0,
            0,
            0,
            255
          ],
          "name": "/MENEHF+NissanAG-Medium",
          "size": 1.0
        },
        "text": "than the company’s tangible fixed assets. In the"
      },
      {
        "bbox": [
          146.97122193277312,
          345.0883081947744,
          211.9114251260504,
          9.62303355106883
        ],
        "font": {
          "color": [
            0,
