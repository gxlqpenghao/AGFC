            12,
            72,
            142,
            255
          ],
          "name": "/AAAAAG+AGaramond-Regular",
          "size": 1.0
        },
        "text": "don’t act like it. "
      },
      {
        "bbox": [
          528.4834681372549,
          809.2296183712122,
          89.52817279411761,
          67.67691919191921
        ],
        "font": {
          "color": [
            12,
            72,
