          873.7075564133988,
          67.67689330808088
        ],
        "font": {
          "color": [
            41,
            59,
            31,
            255
          ],
          "name": "/AAAAAG+AGaramond-Regular",
          "size": 1.0
        },
        "text": "“You know the people you work "
      },
      {
        "bbox": [
          91.91898361928105,
          672.4775350378789,
          872.737926511438,
          67.67691919191913
        ],
        "font": {
