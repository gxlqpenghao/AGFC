        },
        "text": "Predecessor Auditor (Arthur Andersen LLP) Opinion"
      }
    ],
    [
      {
        "bbox": [
          113.88888888888889,
          332.37717783656683,
          515.7600694444444,
          12.245779247501332
        ],
        "font": {
