        },
        "text": "O UR S HAREHOLDERS:"
      }
    ],
    [
      {
        "bbox": [
          293.20002483164984,
          503.24060820413445,
          13.331281144781144,
          11.918604651162752
        ],
        "font": {
          "color": [
            0,
            0,
