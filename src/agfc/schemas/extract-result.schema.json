{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agfc.dev/schemas/extract-result.schema.json",
  "title": "AGFC Extract Result",
  "type": "object",
  "required": ["engine", "engine_version", "input", "artifacts", "images"],
  "properties": {
    "engine": { "const": "agfc" },
    "engine_version": { "type": "string" },
    "input": {
      "type": "object",
      "required": ["source_path", "source_format"],
      "properties": {
        "source_path": { "type": "string" },
        "source_format": { "type": "string" }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object",
      "required": ["run_dir", "summary_json", "images_dir"],
      "properties": {
        "run_dir": { "type": "string" },
        "summary_json": { "type": "string" },
        "images_dir": { "type": "string" }
      },
      "additionalProperties": true
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "page_idx",
          "figure_id",
          "logical_group_id",
          "asset_id",
          "asset_path",
          "figure_bbox",
          "content_bbox",
          "support_bbox"
        ],
        "properties": {
          "page_idx": { "type": "integer" },
          "figure_id": { "type": "string" },
          "logical_group_id": { "type": "string" },
          "asset_id": { "type": "string" },
          "asset_path": { "type": "string" },
          "figure_bbox": { "$ref": "#/$defs/bbox" },
          "content_bbox": { "$ref": "#/$defs/bbox" },
          "support_bbox": { "$ref": "#/$defs/bbox" },
          "panel_ids": { "type": "array", "items": { "type": "string" } },
          "boundary_strategy": { "type": "string" },
          "caption_text": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    }
  }
}
